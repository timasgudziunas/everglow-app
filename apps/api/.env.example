NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ABLY_API_KEY=

# APNs silent push — see APNS_SETUP.md. Leave as PLACEHOLDER to disable push
# (app falls back to the Ably-only relay). No code changes needed to enable.
APNS_KEY_ID=PLACEHOLDER
APNS_TEAM_ID=PLACEHOLDER
APNS_PRIVATE_KEY=PLACEHOLDER
APNS_BUNDLE_ID=com.everglow.app
APNS_ENVIRONMENT=sandbox
